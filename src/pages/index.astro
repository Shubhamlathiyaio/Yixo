---
/**
 * Master workspace wireframe: fixed top nav, telemetry sidebar, scanner +
 * dashboard grid, and the event-driven toast rail.
 */

import Layout from '../layouts/Layout.astro';
import WasteScanner from '../components/WasteScanner.astro';
import DashboardMetrics from '../components/DashboardMetrics.astro';
import {
	ACHIEVEMENTS,
	CATEGORY_META,
	CHALLENGES,
	SEED_TELEMETRY,
	WASTE_ITEMS,
} from '../data/recycle';

const seedUnlocked = ACHIEVEMENTS.filter((badge) => {
	const counts = SEED_TELEMETRY.categoryCounts;
	const values: Record<string, number> = {
		recyclable: counts.recyclable,
		organic: counts.organic,
		eWaste: counts['e-waste'],
		hazardous: counts.hazardous,
		itemsProcessed: SEED_TELEMETRY.itemsProcessed,
		diversionRate:
			((SEED_TELEMETRY.itemsProcessed - SEED_TELEMETRY.landfill) /
				SEED_TELEMETRY.itemsProcessed) *
			100,
		carbonSaved: SEED_TELEMETRY.carbonSaved,
		streak: SEED_TELEMETRY.streak,
		points: SEED_TELEMETRY.points,
	};
	return values[badge.metric] >= badge.threshold;
}).length;

const activeChallenges = CHALLENGES.filter((c) => !SEED_TELEMETRY.challenges[c.id]);
const seedDiversion = (
	(SEED_TELEMETRY.itemsProcessed - SEED_TELEMETRY.landfill) / SEED_TELEMETRY.itemsProcessed
).toFixed(1);

const NAV = [
	{
		id: 'workspace',
		label: 'Workspace',
		icon: 'M4 5h16M4 12h10M4 19h6',
	},
	{ id: 'telemetry', label: 'Telemetry', icon: 'M4 19V5m0 14h16M8 15v-4m4 4V7m4 8v-6' },
	{ id: 'challenges', label: 'Challenges', icon: 'M4 6h16v12H4zM8 11l2 2 4-4' },
	{ id: 'bins', label: 'Bin Guidelines', icon: 'M5 7h14l-1 13H6zM9 7V4h6v3' },
	{ id: 'badges', label: 'Achievements', icon: 'M12 3l2.4 5 5.6.8-4 3.9 1 5.5-5-2.6-5 2.6 1-5.5-4-3.9 5.6-.8z' },
];

/** Live activity feed, seeded from the most recent demo classifications. */
const RECENT = WASTE_ITEMS.slice(0, 5).map((item, index) => ({
	id: item.id,
	label: item.label,
	destination: item.sortDestination.split(' — ')[0],
	carbon: item.carbonOffset,
	ago: ['2 min', '15 min', '48 min', '1 h', '2 h'][index],
	swatch: CATEGORY_META[item.category].hex,
}));
---

<Layout
	title="RE:WASTE AI — Circular Economy Intelligence"
	description="AI-powered waste classification, smart sorting directives and live circular-economy telemetry."
>
	<!-- ==================== Top nav ==================== -->
	<header
		class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-xl supports-[backdrop-filter]:bg-canvas/70"
	>
		<div class="mx-auto flex h-14 max-w-[1600px] items-center gap-4 px-4 sm:px-6">
			<a href="#workspace" class="flex shrink-0 items-center gap-2.5">
				<span
					class="grid h-7 w-7 place-items-center rounded-md border border-line bg-card font-mono text-2xs font-medium text-accent"
					aria-hidden="true">RW</span
				>
				<span class="text-md font-semibold tracking-tight text-ink">
					RE:WASTE <span class="text-mute">AI</span>
				</span>
			</a>

			<nav class="ml-2 hidden items-center gap-1 md:flex" aria-label="Primary">
				{
					NAV.slice(0, 4).map((item) => (
						<a href={`#${item.id}`} class="navlink">
							{item.label}
						</a>
					))
				}
			</nav>

			<div class="ml-auto flex items-center gap-2">
				<span
					class="hidden items-center gap-2 rounded-full border border-line px-2.5 py-1 font-mono text-2xs tracking-[0.1em] text-mute uppercase sm:inline-flex"
				>
					<span class="dot dot-live" aria-hidden="true"></span>
					engine v4.12.7
				</span>
				<button type="button" class="btn btn-sm" data-nav-to="workspace">Scan</button>
				<button type="button" class="btn btn-sm btn-primary">Export report</button>
			</div>
		</div>
	</header>

	<div class="mx-auto flex max-w-[1600px]">
		<!-- ==================== Sidebar ==================== -->
		<aside
			class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-[248px] shrink-0 flex-col border-r border-line lg:flex"
			aria-label="Workspace navigation"
		>
			<div class="flex-1 overflow-y-auto p-4">
				<!-- Operator -->
				<div class="mb-6 rounded-lg border border-line bg-card p-3.5">
					<div class="flex items-center gap-3">
						<span
							class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line bg-surface font-mono text-2xs text-mute"
							aria-hidden="true">KO</span
						>
						<div class="min-w-0">
							<p class="truncate text-sm font-medium text-ink">K. Okafor</p>
							<p class="truncate font-mono text-2xs text-faint">ward 14 · operator</p>
						</div>
					</div>
					<dl class="mt-3.5 grid grid-cols-2 gap-px overflow-hidden rounded-md bg-line">
						<div class="bg-surface px-2.5 py-2">
							<dt class="font-mono text-2xs tracking-[0.08em] text-faint uppercase">pts</dt>
							<dd
								class="tnum mt-0.5 font-mono text-sm text-ink"
								data-side-points>{SEED_TELEMETRY.points.toLocaleString('en-US')}</dd
							>
						</div>
						<div class="bg-surface px-2.5 py-2">
							<dt class="font-mono text-2xs tracking-[0.08em] text-faint uppercase">streak</dt>
							<dd class="tnum mt-0.5 font-mono text-sm text-ink" data-side-streak>
								{SEED_TELEMETRY.streak}d
							</dd>
						</div>
					</dl>
				</div>

				<!-- Nav -->
				<p class="eyebrow mb-2 px-1">sections</p>
				<nav class="flex flex-col gap-0.5" aria-label="Workspace sections">
					{
						NAV.map((item, index) => (
							<a
								href={`#${item.id}`}
								class="navlink"
								aria-current={index === 0 ? 'true' : undefined}
								data-nav-link={item.id}
							>
								<svg
									width="14"
									height="14"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d={item.icon} />
								</svg>
								{item.label}
							</a>
						))
					}
				</nav>

				<!-- Live session -->
				<p class="eyebrow mb-2 mt-6 px-1">session.telemetry</p>
				<dl class="flex flex-col gap-px overflow-hidden rounded-md border border-line">
					<div class="flex items-center justify-between bg-card px-3 py-2">
						<dt class="text-sm text-mute">diverted</dt>
						<dd class="tnum font-mono text-sm text-accent" data-side-diversion>{seedDiversion}%</dd>
					</div>
					<div class="flex items-center justify-between bg-card px-3 py-2">
						<dt class="text-sm text-mute">carbon</dt>
						<dd class="tnum font-mono text-sm text-accent" data-side-carbon>
							- {SEED_TELEMETRY.carbonSaved.toFixed(1)} kg
						</dd>
					</div>
					<div class="flex items-center justify-between bg-card px-3 py-2">
						<dt class="text-sm text-mute">badges</dt>
						<dd class="tnum font-mono text-sm text-ink">
							<span class="text-accent" data-side-badges>{seedUnlocked}</span>/{ACHIEVEMENTS.length}
						</dd>
					</div>
					<div class="flex items-center justify-between bg-card px-3 py-2">
						<dt class="text-sm text-mute">active tasks</dt>
						<dd class="tnum font-mono text-sm text-ink" data-side-active>
							{activeChallenges.length}
						</dd>
					</div>
				</dl>

				<!-- Active challenges, condensed -->
				<p class="eyebrow mb-2 mt-6 px-1">next.up</p>
				<ul class="flex flex-col gap-1.5">
					{
						activeChallenges.slice(0, 3).map((challenge) => (
							<li>
								<a
									href="#challenges"
									class="block rounded-md border border-line-soft px-2.5 py-2 transition-colors hover:border-line-strong hover:bg-surface"
								>
									<span class="block truncate text-sm text-ink">{challenge.label}</span>
									<span class="mt-0.5 block font-mono text-2xs text-faint">
										+{challenge.points} pts · +{challenge.impact.streakDays}d
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Engine status -->
			<div class="border-t border-line p-4">
				<div class="flex items-center justify-between rounded-md bg-surface px-3 py-2">
					<span class="flex items-center gap-2 font-mono text-2xs text-mute">
						<span class="dot dot-live" aria-hidden="true"></span>
						inference online
					</span>
					<span class="tnum font-mono text-2xs text-faint">12 ms</span>
				</div>
			</div>
		</aside>

		<!-- ==================== Main ==================== -->
		<main id="workspace" class="min-w-0 flex-1">
			<!-- Hero -->
			<section class="relative overflow-hidden border-b border-line px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
				<div class="lattice pointer-events-none absolute inset-0" aria-hidden="true"></div>
				<div
					class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[42rem] -translate-x-1/2 rounded-full bg-accent/8 blur-[120px]"
					aria-hidden="true"
				>
				</div>

				<div class="relative mx-auto max-w-3xl text-center">
					<p class="eyebrow">circular.economy.intelligence</p>
					<h1
						class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-balance text-ink sm:text-5xl lg:text-6xl"
					>
						Point the lens.<br class="hidden sm:block" />
						Get a sorting directive.
					</h1>
					<p class="mx-auto mt-5 max-w-xl text-lg text-body text-balance">
						Classify any material from a single frame. The engine returns the exact stream, the
						handling protocol and the carbon you just avoided — in about two seconds.
					</p>

					<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
						<button type="button" class="btn btn-primary" data-nav-to="scanner">
							Start a scan
							<svg
								width="14"
								height="14"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<path d="M5 12h14M13 6l6 6-6 6"></path>
							</svg>
						</button>
						<button type="button" class="btn" data-nav-to="telemetry">
							View telemetry
						</button>
					</div>

					<dl
						class="mx-auto mt-12 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-4"
					>
						{
							[
								{ label: 'items scanned', value: SEED_TELEMETRY.itemsProcessed.toLocaleString('en-US') },
								{ label: 'diverted', value: `${seedDiversion}%` },
								{ label: 'co₂ avoided', value: `${SEED_TELEMETRY.carbonSaved.toFixed(1)} kg` },
								{ label: 'active streak', value: `${SEED_TELEMETRY.streak} days` },
							].map((stat) => (
								<div class="bg-card px-4 py-4">
									<dt class="font-mono text-2xs tracking-[0.1em] text-faint uppercase">
										{stat.label}
									</dt>
									<dd class="tnum mt-1.5 font-mono text-lg text-ink">{stat.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- Workspace grid -->
			<section id="telemetry" class="scroll-mt-20 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
				<WasteScanner />
			</section>

			<section class="px-4 pb-10 sm:px-6 lg:px-8">
				<DashboardMetrics />
			</section>

			<!-- Activity feed -->
			<section class="border-t border-line px-4 py-6 sm:px-6 lg:px-8" aria-labelledby="activity-title">
				<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="eyebrow">audit.trail</p>
						<h2 id="activity-title" class="mt-1 text-lg font-semibold tracking-tight text-ink">
							Recent classifications
						</h2>
					</div>
					<span class="font-mono text-2xs text-faint">last 60 minutes · ward 14</span>
				</div>

				<div class="overflow-hidden rounded-lg border border-line">
					<div
						class="hidden grid-cols-[minmax(0,2fr)_minmax(0,2fr)_auto_auto] gap-4 border-b border-line bg-surface px-4 py-2.5 font-mono text-2xs tracking-[0.1em] text-faint uppercase md:grid"
					>
						<span>input</span>
						<span>stream</span>
						<span>carbon</span>
						<span class="text-right">age</span>
					</div>
					{
						RECENT.map((row) => (
							<div class="grid grid-cols-1 items-center gap-2 border-b border-line-soft px-4 py-3 last:border-b-0 hover:bg-surface md:grid-cols-[minmax(0,2fr)_minmax(0,2fr)_auto_auto] md:gap-4">
								<span class="flex items-center gap-2.5 text-sm text-ink">
									<span
										class="h-1.5 w-1.5 shrink-0 rounded-full"
										style={`background:${row.swatch}`}
										aria-hidden="true"
									/>
									{row.label}
								</span>
								<span class="truncate font-mono text-2xs text-mute">{row.destination}</span>
								<span class="tnum font-mono text-2xs text-accent">
									-{row.carbon.toFixed(2)} kg CO₂
								</span>
								<span class="font-mono text-2xs text-faint md:text-right">{row.ago} ago</span>
							</div>
						))
					}
				</div>
			</section>
		</main>
	</div>

	<!-- ==================== Footer ==================== -->
	<footer class="border-t border-line">
		<div
			class="mx-auto flex max-w-[1600px] flex-col gap-6 px-4 py-8 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"
		>
			<div class="flex items-center gap-2.5">
				<span
					class="grid h-6 w-6 place-items-center rounded-xs border border-line bg-card font-mono text-2xs text-accent"
					aria-hidden="true">RW</span
				>
				<p class="font-mono text-2xs text-faint">
					RE:WASTE AI · model v4.12.7 · classification accuracy 94.2%
				</p>
			</div>
			<nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer">
				{
					['Municipal guidelines', 'Model card', 'Privacy', 'Status'].map((label) => (
						<a
							href="#workspace"
							class="font-mono text-2xs text-faint transition-colors hover:text-ink"
						>
							{label}
						</a>
					))
				}
			</nav>
		</div>
	</footer>

	<!-- ==================== Toast rail ==================== -->
	<div
		class="pointer-events-none fixed right-4 bottom-4 z-100 flex w-[min(22rem,calc(100vw-2rem))] flex-col gap-2"
		data-toast-rail
		aria-live="polite"
		aria-atomic="false"
	></div>
</Layout>

<script>
	import { getState, derive, fmt, subscribe } from '../lib/telemetry';

	/* ---------------- Scroll-spy sidebar ---------------- */

	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
	const sections = links
		.map((link) => document.getElementById(link.dataset.navLink ?? ''))
		.filter((node): node is HTMLElement => node !== null);

	function spy(): void {
		const probe = window.scrollY + 140;
		let active = sections[0];
		for (const section of sections) {
			if (section.offsetTop <= probe) active = section;
		}
		for (const link of links) {
			const isActive = link.dataset.navLink === active?.id;
			if (isActive) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	}

	if (links.length > 0) {
		spy();
		window.addEventListener('scroll', spy, { passive: true });
		window.addEventListener('resize', spy);
	}

	/* ---------------- Smooth in-page navigation ---------------- */

	for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-nav-to]')) {
		trigger.addEventListener('click', () => {
			const target = document.getElementById(trigger.dataset.navTo ?? '');
			target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	}

	/* ---------------- Sidebar mirrors the shared store ---------------- */

	const sidePoints = document.querySelector('[data-side-points]');
	const sideStreak = document.querySelector('[data-side-streak]');
	const sideDiversion = document.querySelector('[data-side-diversion]');
	const sideCarbon = document.querySelector('[data-side-carbon]');
	const sideActive = document.querySelector('[data-side-active]');
	const sideBadges = document.querySelector('[data-side-badges]');

	function renderSidebar(): void {
		const state = getState();
		const d = derive(state);
		if (sidePoints) sidePoints.textContent = fmt.integer(state.points);
		if (sideStreak) sideStreak.textContent = `${fmt.integer(state.streak)}d`;
		if (sideDiversion) sideDiversion.textContent = fmt.percent(d.diversionRate);
		if (sideCarbon) sideCarbon.textContent = `- ${fmt.one(state.carbonSaved)} kg`;
		if (sideActive) sideActive.textContent = String(d.activeChallenges);
		if (sideBadges) {
			sideBadges.textContent = String(
				document.querySelectorAll('[data-badge][data-unlocked="true"]').length,
			);
		}
	}

	/* ---------------- Toast rail ---------------- */

	const rail = document.querySelector<HTMLElement>('[data-toast-rail]');

	function toast(detail: { title: string; body: string; swatch?: string }): void {
		if (!rail) return;

		const node = document.createElement('div');
		node.className =
			'pointer-events-auto flex items-start gap-3 rounded-lg border border-line bg-elevated p-3.5 shadow-[0_8px_32px_rgb(0_0_0_/_0.6)]';
		node.setAttribute('data-fresh', '');
		node.innerHTML = `
			<span class="mt-1 h-2 w-2 shrink-0 rounded-full" style="background:${detail.swatch ?? '#00ff66'}"></span>
			<span class="min-w-0 flex-1">
				<span class="block text-sm font-medium text-ink">${detail.title}</span>
				<span class="mt-0.5 block font-mono text-2xs text-mute">${detail.body}</span>
			</span>`;

		rail.appendChild(node);
		window.setTimeout(() => {
			node.style.transition = 'opacity 240ms ease, transform 240ms ease';
			node.style.opacity = '0';
			node.style.transform = 'translateY(6px)';
			window.setTimeout(() => node.remove(), 260);
		}, 4200);

		while (rail.children.length > 3) rail.firstElementChild?.remove();
	}

	window.addEventListener('reuse:toast', (event) => {
		toast((event as CustomEvent).detail);
	});

	window.addEventListener('reuse:challenge', (event) => {
		const detail = (event as CustomEvent).detail;
		toast({
			title: detail.completed ? `Completed — ${detail.label}` : `Reopened — ${detail.label}`,
			body: detail.completed
				? `+${detail.points} pts applied to session telemetry`
				: 'Telemetry rolled back to the prior state',
			swatch: detail.completed ? detail.swatch : '#737373',
		});
	});

	/* ---------------- Reveal on scroll ---------------- */

	const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
	if (revealTargets.length > 0 && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-in');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
		);
		for (const target of revealTargets) observer.observe(target);
	} else {
		for (const target of revealTargets) target.classList.add('is-in');
	}

	subscribe(renderSidebar);
	renderSidebar();
</script>
